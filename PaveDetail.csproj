<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Abr.PaveDetail</AssemblyName>
    <RootNamespace>PaveDetail</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <RoburInstallDir Condition="'$(RoburInstallDir)' == ''">C:\Program Files\Topomatic Robur Road 16.0</RoburInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Topomatic.ApplicationPlatform">
      <HintPath>$(RoburInstallDir)\Topomatic.ApplicationPlatform.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Topomatic.Cad.Foundation">
      <HintPath>$(RoburInstallDir)\Topomatic.Cad.Foundation.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Topomatic.Cad.View">
      <HintPath>$(RoburInstallDir)\Topomatic.Cad.View.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Topomatic.ComponentModel">
      <HintPath>$(RoburInstallDir)\Topomatic.ComponentModel.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Topomatic.Controls">
      <HintPath>$(RoburInstallDir)\Topomatic.Controls.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Topomatic.Dwg">
      <HintPath>$(RoburInstallDir)\Topomatic.Dwg.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Topomatic.Dwg.Layer">
      <HintPath>$(RoburInstallDir)\Topomatic.Dwg.Layer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- DrawingModel (модель «Чертёж») объявлен здесь: без этой ссылки
         Cad/DrawTarget.cs не отличит лист чертежа от плана площадки. -->
    <Reference Include="Topomatic.Dtm">
      <HintPath>$(RoburInstallDir)\Topomatic.Dtm.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Topomatic.FoundationClasses">
      <HintPath>$(RoburInstallDir)\Topomatic.FoundationClasses.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Topomatic.Maps">
      <HintPath>$(RoburInstallDir)\Topomatic.Maps.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Topomatic.Stg">
      <HintPath>$(RoburInstallDir)\Topomatic.Stg.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Topomatic.Visualization">
      <HintPath>$(RoburInstallDir)\Topomatic.Visualization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Topomatic.Sites">
      <HintPath>$(RoburInstallDir)\Topomatic.Sites.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Topomatic.Sites.Core">
      <HintPath>$(RoburInstallDir)\Topomatic.Sites.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Topomatic.Sfc">
      <HintPath>$(RoburInstallDir)\Topomatic.Sfc.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- SemanticDataSet (семантика слоя дорожной одежды) объявлен здесь,
         без этой ссылки PavementLayer.Semantic не компилируется. -->
    <Reference Include="Topomatic.Smt">
      <HintPath>$(RoburInstallDir)\Topomatic.Smt.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Bootstrap\*.cs" LinkBase="Shared\Bootstrap" />
    <Compile Include="..\Shared\Sdk\*.cs" LinkBase="Shared\Sdk" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PaveDetail.plugin" CopyToOutputDirectory="Always" />
    <None Include="t_pave_detail_tab.plugin" CopyToOutputDirectory="Always" />
    <None Include="icons\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="abr.ico" />
    <EmbeddedResource Include="Catalog\materials.json" />
    <EmbeddedResource Include="Catalog\borders.json" />
  </ItemGroup>

</Project>
